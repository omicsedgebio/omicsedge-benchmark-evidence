{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/project003/v1/experiment.schema.json",
  "title": "EXPERIMENT",
  "description": "One submitted pipeline applied to one sample and sequencing condition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "source_corpus",
    "source_submission_id",
    "sample_id",
    "technology",
    "platform",
    "coverage",
    "pipeline_name",
    "caller_names",
    "caller_versions",
    "reference_assembly",
    "metadata_artifact_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "source_corpus": {"type": "string", "minLength": 1},
    "source_submission_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "technology": {"enum": ["ILLUMINA", "ONT", "PACBIO_HIFI", "MULTI", "UNKNOWN"]},
    "platform": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1},
    "library_preparation": {"type": "string", "minLength": 1, "default": "UNKNOWN"},
    "basecaller": {"type": "string", "minLength": 1, "default": "UNKNOWN"},
    "basecaller_version": {"type": "string", "minLength": 1, "default": "UNKNOWN"},
    "aligner_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "aligner_versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pipeline_name": {"type": "string", "minLength": 1},
    "pipeline_version": {"type": "string", "minLength": 1, "default": "UNKNOWN"},
    "caller_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "caller_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reference_assembly": {"type": "string", "minLength": 1},
    "metadata_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selection_basis": {"type": "string", "minLength": 1},
    "performance_consulted_for_selection": {"const": false},
    "notes": {"type": ["string", "null"]}
  }
}


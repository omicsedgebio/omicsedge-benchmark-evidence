{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/atlas/0.1.0/eligibility_assessment.schema.json",
  "title": "ELIGIBILITY_ASSESSMENT",
  "description": "One evaluation of one catalog record version against one eligibility policy version. The outcome must equal the deterministic aggregation of the criterion decisions, and E13 must equal the decision derived from the recorded hard-gate field methods (enforced by evidence_atlas.protocol.validate_eligibility_assessment).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "record_id",
    "record_version",
    "policy_version",
    "evaluated_at",
    "evaluator",
    "hard_gate_fields",
    "criteria",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.defs.schema.json#/$defs/schema_version"
    },
    "assessment_id": {
      "$ref": "common.defs.schema.json#/$defs/id"
    },
    "record_id": {
      "$ref": "common.defs.schema.json#/$defs/id"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "$ref": "common.defs.schema.json#/$defs/semver"
    },
    "evaluated_at": {
      "$ref": "common.defs.schema.json#/$defs/utc_timestamp"
    },
    "evaluator": {
      "$ref": "common.defs.schema.json#/$defs/agent"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "decision",
          "basis"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          },
          "decision": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "NEEDS_REVIEW"
      ]
    },
    "hard_gate_fields": {
      "description": "How each hard-gate field was backed at evaluation time.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "method"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "method": {
            "$ref": "common.defs.schema.json#/$defs/normalization_method"
          },
          "curation_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

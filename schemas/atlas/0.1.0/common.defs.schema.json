{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/atlas/0.1.0/common.defs.schema.json",
  "title": "Evidence Atlas shared definitions",
  "description": "Reusable definitions for the Evidence Atlas expansion entity model (schema family atlas-0.1.0). Not a record type on its own.",
  "$defs": {
    "schema_version": {"const": "atlas-0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$", "minLength": 1, "maxLength": 200},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utc_timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "https_or_ftp_uri": {"type": "string", "pattern": "^(https|ftp|s3|gs)://\\S+$"},
    "ncbi_taxonomy_id": {"type": "integer", "minimum": 1},
    "insdc_run_accession": {"type": "string", "pattern": "^[SED]RR[0-9]{6,}$"},
    "insdc_experiment_accession": {"type": "string", "pattern": "^[SED]RX[0-9]{6,}$"},
    "insdc_study_accession": {"type": "string", "pattern": "^[SED]RP[0-9]{6,}$"},
    "biosample_accession": {"type": "string", "pattern": "^SAM(N|EA|D)[0-9]+$"},
    "bioproject_accession": {"type": "string", "pattern": "^PRJ(NA|EB|DB)[0-9]+$"},
    "assembly_accession": {"type": "string", "pattern": "^GC[AF]_[0-9]{9}\\.[0-9]+$"},
    "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
    "access_class": {"enum": ["OPEN", "CONTROLLED", "UNKNOWN"]},
    "layer": {"enum": ["PUBLIC_DATA_CATALOG", "EVIDENCE_CANDIDATE", "VALIDATED_RELEASE"]},
    "eligibility_state": {
      "enum": [
        "CATALOGUED",
        "ELIGIBILITY_PENDING",
        "ELIGIBLE",
        "INELIGIBLE",
        "NEEDS_REVIEW",
        "VALIDATION_PENDING",
        "VALIDATED",
        "VALIDATION_FAILED",
        "RELEASED",
        "WITHDRAWN"
      ]
    },
    "normalization_method": {
      "enum": ["SOURCE_CONTROLLED", "RULE_EXACT", "RULE_PATTERN", "CURATED", "ML_PROPOSED", "UNRESOLVED"]
    },
    "normalized_value": {
      "description": "A normalized field that preserves the raw source value, the method that produced the normalized value, and its confidence. UNKNOWN means not determinable; UNSPECIFIED means the source deliberately gives only a coarser level (e.g. instrument family without model).",
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "value", "method", "confidence"],
      "properties": {
        "raw_value": {"type": ["string", "null"]},
        "value": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
        "method": {"$ref": "#/$defs/normalization_method"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "normalizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
        },
        "ml": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "model_version", "input_sha256"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1},
            "model_version": {"type": "string", "minLength": 1},
            "input_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "curation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["curator", "decided_at", "rationale"],
          "properties": {
            "curator": {"type": "string", "minLength": 1},
            "decided_at": {"$ref": "#/$defs/utc_timestamp"},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "ML_PROPOSED"}}},
          "then": {"required": ["ml"]},
          "else": {"not": {"required": ["ml"]}}
        },
        {
          "if": {"properties": {"method": {"const": "CURATED"}}},
          "then": {"required": ["curation"]}
        },
        {
          "if": {"properties": {"method": {"const": "UNRESOLVED"}}},
          "then": {"properties": {"value": {"const": "UNKNOWN"}, "confidence": {"const": 0}}}
        },
        {
          "if": {"properties": {"method": {"enum": ["SOURCE_CONTROLLED", "RULE_EXACT", "RULE_PATTERN"]}}},
          "then": {"required": ["normalizer"]}
        }
      ]
    },
    "source_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms_id", "compatibility"],
      "properties": {
        "terms_id": {"type": "string", "minLength": 1},
        "terms_url": {"$ref": "#/$defs/https_or_ftp_uri"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_retrieved_at": {"$ref": "#/$defs/utc_timestamp"},
        "compatibility": {"enum": ["COMPATIBLE", "INCOMPATIBLE", "UNREVIEWED"]},
        "attribution_required": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "if": {"properties": {"compatibility": {"enum": ["COMPATIBLE", "INCOMPATIBLE"]}}},
      "then": {"required": ["snapshot_sha256", "snapshot_retrieved_at"]}
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["SOFTWARE", "WORKFLOW", "HUMAN", "SOURCE_SYNC", "RELEASE_BUILD"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": [
            "ORGANISM",
            "REFERENCE_ASSEMBLY",
            "REFERENCE_SEQUENCE_SET",
            "STUDY",
            "SAMPLE",
            "SEQUENCING_RUN",
            "SOURCE_RECORD",
            "PUBLICATION",
            "TRUTH_SOURCE",
            "DERIVED_ARTIFACT",
            "CATALOG_RECORD",
            "ELIGIBILITY_ASSESSMENT",
            "RELEASE_MANIFEST"
          ]
        },
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

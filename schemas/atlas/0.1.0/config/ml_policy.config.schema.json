{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/atlas/0.1.0/config/ml_policy.config.schema.json",
  "title": "ML policy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "status",
    "notice",
    "principle",
    "normalization_methods",
    "allowed_tasks",
    "prohibited_decisions",
    "rule_conflict_behaviour",
    "deployment_requirements",
    "thresholds",
    "model_registry"
  ],
  "properties": {
    "policy_version": {
      "$ref": "../common.defs.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "normalization_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "description",
          "ml"
        ],
        "properties": {
          "method": {
            "$ref": "../common.defs.schema.json#/$defs/normalization_method"
          },
          "description": {
            "type": "string"
          },
          "ml": {
            "type": "boolean"
          }
        }
      }
    },
    "allowed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "output"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "output": {
            "type": "string"
          }
        }
      }
    },
    "prohibited_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "reason"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rule_conflict_behaviour": {
      "type": "string",
      "minLength": 1
    },
    "deployment_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "active",
        "validated",
        "calibration_milestone",
        "statement",
        "provisional_values",
        "applies_to",
        "behaviour_while_inactive",
        "behaviour_when_active",
        "activation_requirements",
        "activation_record"
      ],
      "properties": {
        "status": {
          "enum": [
            "PROVISIONAL",
            "ACTIVE"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "calibration_milestone": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "provisional_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accept_threshold",
            "review_threshold",
            "min_precision_at_accept"
          ],
          "properties": {
            "accept_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "review_threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "min_precision_at_accept": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "applies_to": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_while_inactive": {
          "type": "string",
          "minLength": 1
        },
        "behaviour_when_active": {
          "type": "object"
        },
        "activation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6
        },
        "activation_record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activated_in_policy_version",
                "approved_by",
                "approved_at",
                "reports"
              ],
              "properties": {
                "activated_in_policy_version": {
                  "$ref": "../common.defs.schema.json#/$defs/semver"
                },
                "approved_by": {
                  "type": "string",
                  "minLength": 1
                },
                "approved_at": {
                  "$ref": "../common.defs.schema.json#/$defs/utc_timestamp"
                },
                "reports": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evaluation_set",
                    "class_performance",
                    "calibration",
                    "abstention",
                    "error_analysis",
                    "threshold_rationale"
                  ],
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "$ref": "../common.defs.schema.json#/$defs/sha256"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "ACTIVE"
              },
              "validated": {
                "const": true
              },
              "activation_record": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "const": "PROVISIONAL"
              },
              "activation_record": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "model_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_models",
        "statement"
      ],
      "properties": {
        "active_models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model_id",
              "model_version"
            ],
            "properties": {
              "model_id": {
                "type": "string"
              },
              "model_version": {
                "type": "string"
              }
            }
          }
        },
        "statement": {
          "type": "string"
        }
      }
    }
  }
}

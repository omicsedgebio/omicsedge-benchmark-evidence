{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/atlas/0.1.0/config/eligibility_policy.config.schema.json",
  "title": "Eligibility policy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "status",
    "notice",
    "layers",
    "states",
    "initial_state",
    "transitions",
    "transition_rules",
    "decision_values",
    "aggregation",
    "criteria",
    "hard_gate_fields",
    "hard_gate_accepted_methods",
    "ml_hard_gate_rule"
  ],
  "properties": {
    "policy_version": {
      "$ref": "../common.defs.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "description",
          "states"
        ],
        "properties": {
          "layer_id": {
            "$ref": "../common.defs.schema.json#/$defs/layer"
          },
          "description": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "$ref": "../common.defs.schema.json#/$defs/eligibility_state"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "meaning"
        ],
        "properties": {
          "state": {
            "$ref": "../common.defs.schema.json#/$defs/eligibility_state"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "initial_state": {
      "const": "CATALOGUED"
    },
    "transitions": {
      "type": "object",
      "propertyNames": {
        "$ref": "../common.defs.schema.json#/$defs/eligibility_state"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "../common.defs.schema.json#/$defs/eligibility_state"
        },
        "uniqueItems": true
      }
    },
    "transition_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_values": {
      "const": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "aggregation": {
      "type": "object"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "hard",
          "applicability",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "hard": {
            "type": "boolean"
          },
          "applicability": {
            "enum": [
              "ALWAYS",
              "CONDITIONAL"
            ]
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hard_gate_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hard_gate_accepted_methods": {
      "description": "Normalization methods sufficient for a hard-gate field. ML_PROPOSED and UNRESOLVED can never appear here.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "../common.defs.schema.json#/$defs/normalization_method"
          },
          {
            "not": {
              "enum": [
                "ML_PROPOSED",
                "UNRESOLVED"
              ]
            }
          }
        ]
      }
    },
    "ml_hard_gate_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}

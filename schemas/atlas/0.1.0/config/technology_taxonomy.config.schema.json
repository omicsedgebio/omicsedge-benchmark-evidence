{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/atlas/0.1.0/config/technology_taxonomy.config.schema.json",
  "title": "Technology taxonomy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomy_version", "status", "notice", "hierarchy", "rules", "technology_families", "vendors", "instrument_families", "instrument_models", "chemistries", "read_modes", "basecallers", "insdc_platform_terms"],
  "$defs": {
    "cid": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "label": {"type": "string", "minLength": 1}
  },
  "properties": {
    "taxonomy_version": {"$ref": "../common.defs.schema.json#/$defs/semver"},
    "status": {"type": "string"},
    "notice": {"type": "string"},
    "hierarchy": {"const": ["technology_family", "vendor", "instrument_family", "instrument_model", "chemistry", "read_mode"]},
    "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "technology_families": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "evidence_scope"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "evidence_scope": {"enum": ["RELEASED_IN_V1", "EXPANSION_TARGET", "CATALOG_ONLY"]}}}
    },
    "vendors": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}}}
    },
    "instrument_families": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "vendor_id", "technology_family_id", "family_level_aliases"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "vendor_id": {"$ref": "#/$defs/cid"}, "technology_family_id": {"$ref": "#/$defs/cid"},
          "family_level_aliases": {"type": "array", "items": {"$ref": "#/$defs/label"}, "uniqueItems": true}}}
    },
    "instrument_models": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "instrument_family_id", "source_aliases"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "instrument_family_id": {"$ref": "#/$defs/cid"},
          "source_aliases": {"type": "array", "items": {"$ref": "#/$defs/label"}, "uniqueItems": true}}}
    },
    "chemistries": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "vendor_id", "technology_family_id", "kind"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "vendor_id": {"$ref": "#/$defs/cid"}, "technology_family_id": {"$ref": "#/$defs/cid"},
          "kind": {"enum": ["sequencing_chemistry", "pore_version", "library_kit", "sequencing_kit"]}}}
    },
    "read_modes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "technology_family_ids"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "technology_family_ids": {"type": "array", "items": {"$ref": "#/$defs/cid"}, "minItems": 1, "uniqueItems": true}}}
    },
    "basecallers": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "vendor_id", "technology_family_id"],
        "properties": {"id": {"$ref": "#/$defs/cid"}, "label": {"$ref": "#/$defs/label"}, "vendor_id": {"$ref": "#/$defs/cid"}, "technology_family_id": {"$ref": "#/$defs/cid"}}}
    },
    "insdc_platform_terms": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["term", "vendor_id", "technology_family_id"],
        "properties": {"term": {"type": "string", "pattern": "^[A-Z0-9_]+$"}, "vendor_id": {"$ref": "#/$defs/cid"},
          "technology_family_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cid"}]}, "note": {"type": "string"}}}
    }
  }
}

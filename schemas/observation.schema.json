{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsedgebio.example/schemas/project003/v1/observation.schema.json",
  "title": "OBSERVATION",
  "description": "One side-specific source-record decision within one run-scoped event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "benchmark_run_id",
    "event_id",
    "side",
    "observation_origin",
    "raw_decision",
    "normalized_decision",
    "raw_match_kind",
    "region_status",
    "source_output_artifact_id",
    "source_record_ordinal",
    "source_contig",
    "source_pos_1based",
    "source_ref",
    "source_alt",
    "source_filter",
    "normalization_method",
    "normalization_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "minLength": 1},
    "benchmark_run_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "side": {"enum": ["TRUTH", "QUERY"]},
    "observation_origin": {"const": "REGENERATED"},
    "raw_decision": {"type": "string", "minLength": 1},
    "normalized_decision": {"enum": ["TP", "FP", "FN", "N", "UNK", "IGN", "OTHER"]},
    "raw_match_kind": {"type": "string", "minLength": 1},
    "raw_engine_detail": {"type": ["string", "null"]},
    "raw_variant_type": {"type": ["string", "null"]},
    "raw_location_type": {"type": ["string", "null"]},
    "region_status": {"enum": ["INSIDE", "OUTSIDE", "BORDER", "UNKNOWN"]},
    "source_output_artifact_id": {"type": "string", "minLength": 1},
    "source_record_ordinal": {"type": "integer", "minimum": 1},
    "source_contig": {"type": "string", "minLength": 1},
    "source_pos_1based": {"type": "integer", "minimum": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "source_alt": {"type": "string", "minLength": 1},
    "source_genotype": {"type": ["string", "null"]},
    "source_filter": {"type": "array", "items": {"type": "string"}},
    "quality_score": {"type": ["number", "null"]},
    "normalization_method": {"type": "string", "minLength": 1},
    "normalization_version": {"type": "string", "minLength": 1},
    "normalized_start_0based": {"type": ["integer", "null"], "minimum": 0},
    "normalized_end_0based": {"type": ["integer", "null"], "minimum": 1},
    "normalized_ref": {"type": ["string", "null"]},
    "normalized_alt": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}


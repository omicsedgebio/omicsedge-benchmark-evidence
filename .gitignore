# Their URLs/checksums/manifests remain versioned.
data/phase2/truth_beds/

# Phase 2 large query/truth VCF staging.
data/phase2/query_vcfs/
data/phase2/truth_vcfs/
data/phase2/downloads/
data/phase2/raw/

